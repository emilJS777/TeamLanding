# Frontend: leave empty for same-origin /api/project-inquiries.
VITE_PROJECT_INQUIRY_API_URL=
VITE_CONTACT_MESSAGE_API_URL=

# Server-only SMTP configuration. Never prefix secrets with VITE_.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=deneonofficial@gmail.com
SMTP_PASSWORD=
PROJECT_INQUIRY_RECIPIENT=deneonofficial@gmail.com
CONTACT_MESSAGE_RECIPIENT=deneonofficial@gmail.com
PROJECT_INQUIRY_FROM="DENeon Team <deneonofficial@gmail.com>"
ALLOWED_ORIGINS=https://team.deneon.net,https://www.team.deneon.net
PROJECT_INQUIRY_RATE_LIMIT=5
CONTACT_MESSAGE_RATE_LIMIT=8
PORT=8080

# Local delivery test only; outputs JSON instead of contacting SMTP.
# SMTP_TRANSPORT=json
